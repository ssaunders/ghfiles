   /**
    *  @Function standardizeCuInfo
    *  Takes cu input from wherever I have copied it, in whatever format,
    *  and standardizes the data names.
    */
   function standardizeCuInfo(cuInfoObj) {
      var newCuInfoObj = cuInfoObj, cuName, namePartsFirst, namePartsSecond, typeOfSub, npnPartyIdParts;

      // ADDRESS INFO
      var custAddress = cuInfoObj["Cust Addr"] || cuInfoObj.address || cuInfoObj.Address || "";

      newCuInfoObj.state = (cuInfoObj.state || cuInfoObj.State)
      if(newCuInfoObj.state == undefined || newCuInfoObj.state == "") {
         stateFromAddr = (cuInfoObj["Cust Addr"] || "").match(/.* ([A-Z][A-Z]) \d{5}/)
         newCuInfoObj.state = stateFromAddr != null && stateFromAddr.length >= 0 ? stateFromAddr[1].toUpperCase() : "";
      }
      if(custAddress == "" || custAddress == "no address given" || custAddress == undefined) {
         newCuInfoObj.zip = "";
      } else {
         newCuInfoObj.zip = custAddress.match(/(\d{5})(-\d+)?$/)[1];
      }

      // CU INFO
      newCuInfoObj.leadId = cuInfoObj["Lead ID"] || cuInfoObj["Lead Id"] || cuInfoObj["Lead id"] 
                         || cuInfoObj["lead id"] || cuInfoObj["lead_id"] || cuInfoObj["leadId"]  
                         || cuInfoObj["leadid"]  || cuInfoObj["LeadID"]  || cuInfoObj["LeadId"];
      newCuInfoObj.dob = cuInfoObj.dob || cuInfoObj.DOB || cuInfoObj["Date of Birth"] || cuInfoObj["Birth Date"] || "";
      newCuInfoObj.sex = cuInfoObj.sex || cuInfoObj.Gender || "";
      newCuInfoObj.mbi = cuInfoObj.mbi || cuInfoObj["Medicare ID"] || cuInfoObj["MBI Number"] || cuInfoObj.MBI || "";
      newCuInfoObj.mcdId = (cuInfoObj.mcdId || cuInfoObj["Medicaid ID"] || "").split(" / ")[0];
      if(newCuInfoObj.mcdId == "-") {
         newCuInfoObj.mcdId = "";
      }
      newCuInfoObj.phoneNum = cuInfoObj.phone || cuInfoObj.Phone || cuInfoObj["Phone Number"] || cuInfoObj["Phone Num"] || "";
      newCuInfoObj.email = cuInfoObj.email || cuInfoObj.Email || cuInfoObj["Email Address"] || cuInfoObj["email address"] || "";

      // NAME (cuInfoObj.Name is to get it from MARx )
      newCuInfoObj.fullName = (cuInfoObj["Customer Name"] || cuInfoObj["Cust Name"] || cuInfoObj["Cu Name"] || "")
                  .replace(/ [JS]r\.?| (I+|IV)/,"")   // get rid of Jr, etc
                  .replace(/ [A-Z]\.? /," ");         // remove middle initials
      nameParts = newCuInfoObj.fullName.match(/([a-z]+( [a-z]+)?)( [a-z]\.?)? ([a-z]+( [a-z]+)?)/i);
      if(nameParts != null) {
         namePartsFirst = nameParts[1];
         namePartsSecond = nameParts[4];
      }
      newCuInfoObj.firstName = cuInfoObj.firstName || namePartsFirst || "";
      newCuInfoObj.lastName = cuInfoObj.lastName || namePartsSecond || "";

      // AGENT INFO
      if(/\//.test(cuInfoObj["Agent NPN/Party ID"])) {
         npnPartyIdParts = cuInfoObj["Agent NPN/Party ID"].split(" / ");
         newCuInfoObj.npn = npnPartyIdParts[0];
         newCuInfoObj.partyId = npnPartyIdParts[1];
      } else {
         newCuInfoObj.npn = cuInfoObj["Agent NPN"];
      }

     return newCuInfoObj;
   }

   /** 
    * Function createColonList
    * Takes an arbitrary number of parameters as sequential key-value pairs 
    * and returns a string where each pair is formatted as "key: \t value", 
    * separated by a newline.
    *
    * @param {...any} args - Sequential key-value arguments (e.g., 'Name', 'Alice', 'Age', 30).
    * @returns {string} A single formatted string.
    */
   function createColonList(...args) {
      const pairs = [];
     
      // Iterate through the arguments two at a time (key and value)
      for (let iter = 0; iter < args.length; iter += 2) {
         const key = args[iter];
         const value = args[iter + 1];
         
         if(key == "add_break") {
            pairs.push("");
         } else if (key !== undefined && value !== undefined) {
            // Check if we have both a key and a value for this pair
  
            // Create the formatted string for the pair: key: \t value
            pairs.push(`${key}:\t${value}`);
         } else if (key !== undefined) {
            // TODO: Handle an odd number of arguments by adding the last key alone
            console.warn(`Missing value for key: ${key}`);
         }
      }
     
      // Join all the formatted pairs with a newline character
      return pairs.join('\n');
   }


