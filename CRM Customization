   function setInputField(input, val) {
      var evtConfig = {
         bubbles: true,
         cancelBubble: false,
         cancelable: false,
         composed: true,
         currentTarget: null,
         data: val,
         dataTransfer: null,
         defaultPrevented: false,
         inputType: "insertText",
         srcElement: input,
         target: input,
         type: "input"
      }

      if(input != undefined && val != undefined) {
         input.value = val;
         input.dispatchEvent(new Event('input',evtConfig));
         return true;
      } else {
         return false;
      }
   }

