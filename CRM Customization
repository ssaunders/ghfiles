   /* Function fillFields
      Fills the search fields */
   function fillFields(data){
      console.warn("fillFields data:",data);
      var fillSuccessful = false;

      fillSuccessful = setCustomerIdField(data.custId) && fillSuccessful;
      if(data.firstName) {
         fillSuccessful = setFirstNameField(data.firstName) && fillSuccessful;
      }
      if(data.lastName) {
         fillSuccessful = setLastNameField(data.lastName) && fillSuccessful;
      }
      fillSuccessful = setPhoneNumberField(data.phone) && fillSuccessful;

      if(!isAdvSearchOpen() && (data.zip || data.dob || data.leadId)) {
         toggleAdvSearch();
         setTimeout(() => {
            setDobField(data.dob);
            if(data.zip) {
               setZipField(data.zip);
            }
            setLeadIdField(data.leadId);
            submitIfComplete();
         },50);
      } else {
         fillSuccessful = true;
         fillSuccessful = setDobField(data.dob) && fillSuccessful;
         if(data.zip) {
         fillSuccessful = setZipField(data.zip) && fillSuccessful;
         }
         fillSuccessful = setLeadIdField(data.leadId) && fillSuccessful;
      }


      return fillSuccessful;
   }

