   /* Function addMutationObs
    * Adds a mutation observer to targetEl. Returns the observer.
    * The fn passed in will receive these arguments:
    *   mutationList - the list of changes.
    *   observer - The observer instance.
    *   https://developer.mozilla.org/en-US/docs/Web/API/MutationObserver
    *
    *   OPTIONS DETAILS:
    *   subtree / Optional / default: false
    *       true = monitors the entire subtree target. Any other options will also apply to the subtree.
    *
    *   childList / Optional / default: false
    *       true = monitor the target node for the addition/removal of child nodes
    *
    *   attributes / Optional / default: false, unless attributeFilter/attributeOldValue is true
    *       true = watch for changes to the value of attributes on the node or nodes being monitored.
    *
    *   attributeFilter / Optional / default: false
    *       array of attribute names to be monitored. If this isn't included, any attribute change causes mutation notifications.
    *
    *   attributeOldValue / Optional / default: false
    *       true = records the prev value of any attribute that changes
    *
    *   characterData / Optional / default: false, unless characterDataOldValue is true
    *       true = monitor the specified target node for changes to the character data contained within the node or nodes.
    *
    *   characterDataOldValue / Optional / default: false
    *       true = record the prev value of a node's text whenever the text changes on nodes being monitored.
    */
   function addMutationObs(targetEl, fn, options = {childList:true}) {
      if(typeof fn != "function") {
         fn = () => console.log("ran mutationObserver for ",targetEl);
      }
      if(typeof options != "object") {
         options = {childList:true, subtree:true};
      }
      if(targetEl.val) { // strip out the jQuery object
         targetEl = targetEl[0];
      }

      var mutationObs = new MutationObserver(fn);
      mutationObs.observe(targetEl, options);

      return mutationObs;
   }

