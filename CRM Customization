   /* Function pasteInSearchInfo
      Takes the info in the clipboard and pastes it into the correct fields */
   function pasteInSearchInfo(evt) {
      // CTRL + SHIFT + V // V b/c it's paste
      if (evt.ctrlKey && evt.shiftKey && evt.which == 86) {
         console.log(">> ran pasteInSearchInfo");
         navigator.clipboard
         .readText()
         .then((clipText) => {
               // if (!isAdvSearchOpen()) {
               //    toggleAdvSearch();
               // }

               var cuInfoObj = getObjFromCopiedText(clipText),
                   fillSuccessful;

               clearForm();
               fillSuccessful = fillFields(cuInfoObj);
               // Sometimes fill is not successful, but it still submits
               // that is b/c the Adv Search needs to open first, b/c the
               // fields don't exist unless it's open. In that case, a
               // setTimeout fn will submit the form.
               if(fillSuccessful) {
                  setTimeout(() => {
                     submitIfComplete();
                  }, 50);
               }
         });
      }
   }

