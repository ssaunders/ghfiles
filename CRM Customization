   /* Function setActiveTab
      Navs in the page to a tab with the given name, or returns false if such a tab isn't found*/
   function setActiveTab(tabName=""){
      if(tabName == "") return false;
      if(getActiveTabName() === tabName) return true;

      var tabBar = $$("app-navigation-tabs a"),
          clickedTab = false;

      tabBar.forEach((el, num, ary) => {
         if(el.innerText == tabName) {
            el.click();
            clickedTab = true;
         }
      });

      return clickedTab;
   }


